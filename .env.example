# From Google Cloud Console > Google Auth Platform > Clients (see README.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# The two Google accounts allowed in, comma-separated. Order sets the order in the header.
ALLOWED_EMAILS=you@gmail.com,her@gmail.com

# Set automatically on Vercel by the Upstash Redis integration. Leave empty locally
# to store data in .data/users.json instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Set to 1 to try the app with made-up events and no sign-in (local only).
DEMO_MODE=
